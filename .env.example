# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (public).
# Local Supabase (after `npx supabase start`, values printed by `npx supabase status`):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phase 4 — Google Maps (web JS API key, restricted to your domains):
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Phase 4 — Google Places API key (address search):
EXPO_PUBLIC_PLACES_KEY=

# Phase 7 — Google Sign-In OAuth client IDs:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time native keys (read by app.config.ts during prebuild, not shipped in JS):
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
# Reversed iOS OAuth client id, e.g. com.googleusercontent.apps.1234-abcd:
GOOGLE_IOS_URL_SCHEME=
